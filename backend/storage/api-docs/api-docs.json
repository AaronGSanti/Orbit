                    "401": {
                        "description": "No autorizado"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/v1/tasks/store": {
            "post": {
                "tags": [
                    "Tasks"
                ],
                "summary": "Crear una nueva tarea",
                "operationId": "a6d15c3a88000556710be28e8d10acc5",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "titulo",
                                    "estado",
                                    "prioridad"
                                ],
                                "properties": {
                                    "titulo": {
                                        "type": "string",
                                        "example": "Comprar alimentos"
                                    },
                                    "descripcion": {
                                        "type": "string",
                                        "example": "Comprar frutas, verduras y leche"
                                    },
                                    "estado": {
                                        "type": "string",
                                        "example": "pendiente"
                                    },
                                    "prioridad": {
                                        "type": "string",
                                        "example": "alta"
                                    },
                                    "fecha_limite": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2025-12-31"
                                    },
                                    "task_list_id": {
                                        "type": "integer",
                                        "example": 1
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Tarea creada"
                    },
                    "422": {
                        "description": "Validacion fallida"
                    },
                    "401": {
                        "description": "No autorizado"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
